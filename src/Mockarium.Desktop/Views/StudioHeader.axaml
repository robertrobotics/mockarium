<UserControl x:Class="Mockarium.Desktop.Views.StudioHeader"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mockarium.ViewModels"
             x:DataType="vm:StudioViewModel">
    <StackPanel>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Restore starter" Command="{Binding RestoreCommand}" IsEnabled="{Binding IsConfigured}" Margin="0,0,8,0"/>
                <Button Content="{Binding ToggleText}" Command="{Binding ToggleServerCommand}" IsEnabled="{Binding HasWorkspace}" Classes="primary"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                <Border Classes="status-badge" Classes.live="{Binding IsRunning}" CornerRadius="10" HorizontalAlignment="Left" Padding="9,3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </DockPanel>
        <Border IsVisible="{Binding !IsConfigured}" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Create starter data" Command="{Binding CreateStarterCommand}" IsEnabled="{Binding HasWorkspace}"/>
                <StackPanel>
                    <TextBlock Text="STARTER DATA" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Start with sample data you can edit before connecting an agent." Margin="0,5,0,0" Foreground="{DynamicResource InkBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Classes="card" Padding="15" Margin="0,0,0,14" IsVisible="{Binding HasEndpoint}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy endpoint" Command="{Binding CopyEndpointCommand}" Margin="0,0,8,0"/>
                    <Button Content="Copy configuration" Command="{Binding CopyConfigurationCommand}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="STREAMABLE HTTP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding Endpoint}" FontFamily="monospace" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Expander IsVisible="{Binding IsConfigured}" IsExpanded="{Binding ShowTools}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,20">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Agent toolkit" FontWeight="Bold"/>
                    <TextBlock Text="  ·  Browse available tools and schemas" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Expander.Header>
            <StackPanel>
            <TextBlock Classes="field-label" Text="Search the toolkit"/>
            <TextBox Text="{Binding ToolSearch, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tool name, description, or input"
                     AutomationProperties.Name="Search available tools"/>
            <TextBlock Text="No matching tools. Try a different name or input." IsVisible="{Binding NoMatchingTools}" Margin="0,10" Foreground="{DynamicResource MutedBrush}"/>
            <ItemsControl ItemsSource="{Binding VisibleTools}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolViewModel">
                        <Expander Header="{Binding Name}" Margin="0,3" Background="{DynamicResource SurfaceBrush}" Padding="10">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding Schema, Mode=OneWay}" AutomationProperties.Name="Tool input schema" FontFamily="monospace" FontSize="11" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,8"/>
                                <Button Content="Copy input schema" HorizontalAlignment="Left" CommandParameter="{Binding}"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.CopyToolSchemaCommand}"/>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
