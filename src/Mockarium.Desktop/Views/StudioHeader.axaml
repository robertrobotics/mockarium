<UserControl x:Class="Mockarium.Desktop.Views.StudioHeader"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mockarium.ViewModels"
             x:DataType="vm:StudioViewModel">
    <StackPanel>
        <Border Classes="studio-icon" Tag="{Binding Type}" CornerRadius="16" Padding="20,16" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" IsVisible="{Binding IsConfigured}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <ToggleButton IsChecked="{Binding ShowTools}" Content="Connection and tools" Padding="10,6" ToolTip.Tip="Show endpoint, agent tools and starter data controls"/>
                        <Button Content="{Binding ToggleText}" Command="{Binding ToggleServerCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText, StringFormat='Server · {0}'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" VerticalAlignment="Center" Width="52" Height="52" CornerRadius="14" Margin="0,0,14,0" Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False">
                    <Path Classes="studio-mark" Tag="{Binding Type}" Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" StrokeThickness="2"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="MOCKARIUM   /   LOCAL SIMULATOR" FontSize="10" FontWeight="Bold" LetterSpacing="1"/>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border IsVisible="{Binding !IsConfigured}" Classes="card" Padding="24" Margin="0,2,0,0">
            <Grid ColumnDefinitions="1.4*,*">
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="STARTER KIT" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Starter.Title}" FontSize="24" FontWeight="SemiBold" Margin="0,8"/>
                    <TextBlock Text="{Binding Starter.Contents}" Foreground="{DynamicResource MutedBrush}"/>
                    <Button Content="Create starter data" Classes="primary" Command="{Binding CreateStarterCommand}" IsEnabled="{Binding HasWorkspace}" Margin="0,16,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TRY THIS FIRST" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding Starter.FirstTask}" Margin="0,7,0,0"/>
                        <TextBlock Text="You can edit offline. Start the server when you're ready to connect an agent." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Classes="card" Classes.revealed="{Binding ShowTools}" IsVisible="{Binding ShowTools}" Margin="0,0,0,10">
            <StackPanel>
        <Border Classes="card" Padding="15" Margin="0,0,0,8" IsVisible="{Binding HasEndpoint}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy endpoint" Command="{Binding CopyEndpointCommand}" Margin="0,0,8,0"/>
                    <Button Content="Copy configuration" Command="{Binding CopyConfigurationCommand}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="STREAMABLE HTTP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding Endpoint}" FontFamily="monospace" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
            <TextBlock Text="Start the server to get a client configuration. You can inspect tool inputs offline." Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding !HasEndpoint}"/>
            <TextBlock Classes="field-label" Text="Search the toolkit"/>
            <TextBox Text="{Binding ToolSearch, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tool name, description, or input"
                     AutomationProperties.Name="Search available tools"/>
            <TextBlock Text="No matching tools. Try a different name or input." IsVisible="{Binding NoMatchingTools}" Margin="0,10" Foreground="{DynamicResource MutedBrush}"/>
            <ItemsControl ItemsSource="{Binding VisibleTools}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolViewModel">
                        <Expander Header="{Binding Name}" Margin="0,3" Background="{DynamicResource SurfaceBrush}" Padding="10">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding Schema, Mode=OneWay}" AutomationProperties.Name="Tool input schema" FontFamily="monospace" FontSize="11" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,8"/>
                                <Button Content="Copy input schema" HorizontalAlignment="Left" CommandParameter="{Binding}"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.CopyToolSchemaCommand}"/>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Classes="danger" Content="Restore starter data" Command="{Binding RestoreCommand}"/>
                <TextBlock Text="Reset this studio to its original samples. Execution history is kept." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
