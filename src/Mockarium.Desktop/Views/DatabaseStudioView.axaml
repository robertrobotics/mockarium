<UserControl x:Class="Mockarium.Desktop.Views.DatabaseStudioView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Mockarium.Desktop.Views"
             xmlns:vm="using:Mockarium.ViewModels"
             xmlns:core="using:Mockarium.Core"
             x:DataType="vm:DatabaseStudioViewModel">
    <StackPanel>
        <views:StudioHeader/>
        <TabControl Classes="studio-tabs" IsVisible="{Binding IsConfigured}">
            <TabItem Header="Records">
                <Grid Margin="0,10" ColumnDefinitions="*,1.4*">
                    <Border Classes="card" Margin="0,0,12,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="DATA BROWSER" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                        <DockPanel Margin="0,5,0,10">
                            <Button DockPanel.Dock="Right" Content="+ New" Command="{Binding NewRecordCommand}" AutomationProperties.Name="New record" Padding="8,4"/>
                            <TextBlock Text="Records" Classes="section-title" FontSize="21"/>
                        </DockPanel>
                        <TextBlock Text="Browse table" Classes="field-label"/>
                        <ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" AutomationProperties.Name="Record tables" Margin="0,0,0,8">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TableEditorViewModel"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <ListBox ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" AutomationProperties.Name="Records" MinHeight="300" MaxHeight="520">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="core:DatabaseRecord">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Refresh records" Command="{Binding RefreshCommand}" Margin="0,10,0,0"/>
                    </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="RECORD EDITOR" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedTable.Label, StringFormat='Record in {0}'}" Classes="section-title" FontSize="21" Margin="0,5"/>
                        <TextBlock Text="Choose a row to edit it, or use New for a blank record. For relationships, enter the ID shown under the target record." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding RecordFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecordFieldViewModel">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,10,0,0"/>
                                            <TextBlock Text="{Binding Label}" Classes="field-label"/>
                                        </DockPanel>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Save record" Command="{Binding SaveRecordCommand}" Classes="primary" Margin="0,0,8,0"/>
                            <Button Content="Delete" Command="{Binding DeleteRecordCommand}" AutomationProperties.Name="Delete record" Classes="danger"/>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Model designer">
                <Grid Margin="12" ColumnDefinitions="*,*,1.35*">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Tables" Classes="section-title" Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" AutomationProperties.Name="Model tables" MinHeight="220">
                            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:TableEditorViewModel"><TextBlock Text="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="Add table" Command="{Binding AddTableCommand}" Margin="0,0,4,0"/>
                            <Button Content="Remove" Command="{Binding RemoveTableCommand}" AutomationProperties.Name="Remove table" Classes="danger"/>
                        </UniformGrid>
                        <TextBlock Text="Table label" Classes="field-label"/>
                        <TextBox Text="{Binding SelectedTable.Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Table label"/>
                        <TextBlock Text="Table name" Classes="field-label"/>
                        <TextBox Text="{Binding SelectedTable.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Table name"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Fields" Classes="section-title" Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding SelectedTable.Fields}" SelectedItem="{Binding SelectedField}" AutomationProperties.Name="Table fields" MinHeight="220">
                            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:FieldEditorViewModel"><TextBlock Text="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="Add field" Command="{Binding AddFieldCommand}" Margin="0,0,4,0"/>
                            <Button Content="Remove" Command="{Binding RemoveFieldCommand}" AutomationProperties.Name="Remove field" Classes="danger"/>
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Field details" Classes="section-title"/>
                        <TextBlock Text="The label appears in the editor. The name is the key your agent uses." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                        <TextBlock Text="Label" Classes="field-label"/>
                        <TextBox Text="{Binding SelectedField.Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Field label"/>
                        <TextBlock Text="Name" Classes="field-label"/>
                        <TextBox Text="{Binding SelectedField.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Field name"/>
                        <TextBlock Text="Type" Classes="field-label"/>
                        <ComboBox ItemsSource="{Binding FieldTypes}" SelectedItem="{Binding SelectedField.Type}" AutomationProperties.Name="Field type"/>
                        <TextBlock Text="Relationship target table name" Classes="field-label"/>
                        <TextBox Text="{Binding SelectedField.RelationTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Relationship target table name"/>
                        <CheckBox Content="Required" IsChecked="{Binding SelectedField.Required}" Margin="0,12,0,0"/>
                        <Button Content="Save model changes" Command="{Binding SaveModelCommand}" Classes="primary" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                        <TextBlock Text="Save model changes before starting or stopping the server." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
