<Application x:Class="Mockarium.Desktop.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mockarium.ViewModels"
             xmlns:views="using:Mockarium.Desktop.Views"
             RequestedThemeVariant="Light">
    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><ScrollViewer><views:OverviewView Classes="page"/></ScrollViewer></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmailStudioViewModel}"><ScrollViewer><views:EmailStudioView Classes="page"/></ScrollViewer></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DatabaseStudioViewModel}"><ScrollViewer><views:DatabaseStudioView Classes="page"/></ScrollViewer></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarStudioViewModel}"><ScrollViewer><views:CalendarStudioView Classes="page"/></ScrollViewer></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InspectorViewModel}"><ScrollViewer><views:InspectorView Classes="page"/></ScrollViewer></DataTemplate>
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#006A5B"/>
                <ColorPaletteResources x:Key="Dark" Accent="#78E2C4"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <Style Selector="RadioButton.mode">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="13,3">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="RadioButton.mode:checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="RadioButton.mode:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/></Style>
        <Style Selector=":is(UserControl).page">
            <Setter Property="Margin" Value="30,24,30,32"/>
        </Style>
        <Style Selector=":is(Window):not(.reduced-motion) :is(UserControl).page">
            <Style.Animations>
                <Animation Duration="0:0:0.16">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.75"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector=":is(Window)">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover"><Setter Property="Opacity" Value="0.86"/></Style>
        <Style Selector="Button:pressed"><Setter Property="Opacity" Value="0.72"/></Style>
        <Style Selector=":is(Window).reduced-motion Button"><Setter Property="Transitions" Value="{x:Null}"/></Style>
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#D6DCE8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="Button.nav:pointerover"><Setter Property="Background" Value="#244644"/></Style>
        <Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9BA6BB"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#235749"/>
            <Setter Property="BorderBrush" Value="#457C69"/>
        </Style>
        <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="Border.studio-card">
            <Setter Property="BoxShadow" Value="0 4 14 0 #0A1A2540"/>
            <Setter Property="Transitions">
                <Transitions><BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.studio-icon"><Setter Property="Background" Value="{DynamicResource SecondarySoftBrush}"/></Style>
        <Style Selector="Border.studio-icon TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/></Style>
        <Style Selector="Border.studio-icon[Tag=database]"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
        <Style Selector="Border.studio-icon[Tag=database] TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
        <Style Selector="Border.studio-icon[Tag=calendar]"><Setter Property="Background" Value="{DynamicResource WarmSoftBrush}"/></Style>
        <Style Selector="Border.studio-icon[Tag=calendar] TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarmBrush}"/></Style>
        <Style Selector="Border.status-badge"><Setter Property="Background" Value="{DynamicResource SubtleBrush}"/></Style>
        <Style Selector="Border.status-badge TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
        <Style Selector="Border.status-badge.live"><Setter Property="Background" Value="{DynamicResource PositiveSoftBrush}"/></Style>
        <Style Selector="Border.status-badge.live TextBlock"><Setter Property="Foreground" Value="{DynamicResource PositiveBrush}"/></Style>
        <Style Selector="Border.studio-card:pointerover"><Setter Property="BoxShadow" Value="0 8 24 0 #1C25366B"/></Style>
        <Style Selector=":is(Window).reduced-motion Border.studio-card"><Setter Property="Transitions" Value="{x:Null}"/></Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
    </Application.Styles>
</Application>
