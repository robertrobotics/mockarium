<UserControl x:Class="Mockarium.Wpf.Views.EmailStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Mockarium.Wpf.Views">
    <StackPanel>
        <views:StudioHeader/>
        <TabControl Visibility="{Binding IsConfigured, Converter={StaticResource BoolVisibility}}">
            <TabItem Header="Mailbox">
                <Grid Margin="0,10" Style="{StaticResource PanelEntrance}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="MAILBOX" Foreground="{DynamicResource SecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <DockPanel Margin="0,5,0,12">
                            <Button DockPanel.Dock="Right" Content="+ New" Command="{Binding NewMessageCommand}" AutomationProperties.Name="New message" Padding="8,4"/>
                            <TextBlock Text="Messages" Style="{StaticResource SectionTitle}" FontSize="21" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Browse folder" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" AutomationProperties.Name="Mailbox folders"/>
                        <TextBlock Text="Search this folder" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MessageSearch, UpdateSourceTrigger=PropertyChanged}" MaxLength="250" Margin="0,0,0,6" AutomationProperties.Name="Search this folder"/>
                        <ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" AutomationProperties.Name="Messages" MinHeight="235" MaxHeight="520">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding FromName}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding SentAt}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No messages here. Try another folder or search, or create a message." Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <Button Content="Refresh mailbox" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <Expander Header="Manage folders" HorizontalContentAlignment="Stretch" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="New folder name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New folder name"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Add folder" Command="{Binding AddFolderCommand}" Padding="8,5" Margin="0,0,4,4"/>
                                    <Button Content="Delete folder" Command="{Binding DeleteFolderCommand}" Style="{StaticResource DangerButton}" Padding="8,5"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="MESSAGE EDITOR" Foreground="{DynamicResource SecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Compose a message" Style="{StaticResource SectionTitle}" FontSize="21" Margin="0,5,0,2"/>
                        <TextBlock Text="Start here for a new message, or select one from the list to edit it." Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="To email" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ToEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="To email"/>
                        <TextBlock Text="Subject" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Message subject"/>
                        <TextBlock Text="Message" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Message body" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"/>
                        <TextBlock Text="Save to folder" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding EditFolder}" AutomationProperties.Name="Message folder"/>
                        <Expander Header="Sender and delivery details" HorizontalContentAlignment="Stretch" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="From name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FromName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="From name"/>
                                <TextBlock Text="From email" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FromEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="From email"/>
                                <TextBlock Text="Sent at (ISO 8601)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SentAt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sent at, ISO 8601"/>
                                <TextBlock Text="Parent message ID (optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ParentEmailId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Parent message ID, optional"/>
                            </StackPanel>
                        </Expander>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Save message" Command="{Binding SaveMessageCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Delete" Command="{Binding DeleteMessageCommand}" AutomationProperties.Name="Delete message" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Identity and contacts">
                <Grid Margin="12" Style="{StaticResource PanelEntrance}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Mailbox identity" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Used as the sender for simulated outgoing messages." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,8"/>
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MailboxName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mailbox name"/>
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MailboxEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mailbox email"/>
                            <Button Content="Save identity" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="New" Command="{Binding NewContactCommand}" AutomationProperties.Name="New contact" Padding="8,4"/>
                                <TextBlock Text="Contacts" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" AutomationProperties.Name="Contacts" DisplayMemberPath="Name" Height="140" Margin="0,10,0,0"/>
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contact name"/>
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contact email"/>
                            <TextBlock Text="Company" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ContactCompany, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contact company"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Save contact" Command="{Binding SaveContactCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                <Button Content="Delete" Command="{Binding DeleteContactCommand}" AutomationProperties.Name="Delete contact" Style="{StaticResource DangerButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
