<UserControl x:Class="Mockarium.Wpf.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,26">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border CornerRadius="20" Padding="24" Margin="0,0,14,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#113D3F" Offset="0"/>
                    <GradientStop Color="#14584B" Offset="0.64"/>
                    <GradientStop Color="#216652" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FIELD GUIDE   /   SIMULATION LAB" Foreground="#CFF59F" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="The agent&#x0a;workbench." Foreground="#F4FFE9" FontSize="36" FontWeight="Bold" Margin="0,12,0,8"/>
                    <TextBlock Text="Give your agent a mailbox, a database, and a week to plan. Inspect every call without touching a real service."
                               Foreground="#D6ECE2" FontSize="14" MaxWidth="420" HorizontalAlignment="Left"/>
                </StackPanel>
                <Viewbox Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="180" Height="150">
                    <Path Data="M8,94 L90,51 172,94 90,139 Z" Fill="#403D72" Stroke="#8A84C9"/>
                    <Path Data="M8,71 L90,28 172,71 90,116 Z" Fill="#57508C" Stroke="#AAA2FA"/>
                    <Path Data="M8,48 L90,5 172,48 90,93 Z" Fill="#766DB8" Stroke="#D7D1FF" StrokeThickness="2"/>
                    <Path Data="M35,48 L90,19 145,48 90,78 Z M63,34 L117,63 M63,63 L117,34" Stroke="#AFA6E8"/>
                    <Path Data="M90,94 V138 M8,72 V95 M172,72 V95" Stroke="#AEA7EB" StrokeDashArray="2 3"/>
                    <Ellipse Canvas.Left="85" Canvas.Top="43" Width="10" Height="10" Fill="#ADF0D9"/>
                </Canvas></Viewbox>
            </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}"
                Visibility="{Binding Shell.HasWorkspace, Converter={StaticResource InverseBoolVisibility}}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GET STARTED" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Create your first workspace" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Each workspace keeps its mock data and call history separate." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12"/>
                    <TextBox MaxLength="80" ToolTip="Workspace name" AutomationProperties.Name="Workspace name"
                             Text="{Binding Shell.WorkspaceName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Shell.CreateWorkspaceCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Create workspace" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Command="{Binding Shell.CreateWorkspaceCommand}"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}" Visibility="{Binding Shell.HasWorkspace, Converter={StaticResource BoolVisibility}}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WORKSPACE PULSE" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10"/>
                <TextBlock Text="{Binding Shell.SelectedWorkspace.Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RunningCount}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="of 3 servers online" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <Button Content="Open Live Inspector" HorizontalAlignment="Left" Command="{Binding Shell.NavigateCommand}" CommandParameter="inspector" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        </Grid>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Studio collection" Style="{StaticResource SectionTitle}" FontSize="22"/>
            <TextBlock DockPanel.Dock="Right" Text="LOCAL MOCK SERVICES" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Studios}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <Border Style="{StaticResource StudioIcon}" CornerRadius="9" Width="42" Height="42">
                                    <TextBlock Text="{Binding Symbol}" FontSize="22" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource StudioStatusBadge}" Visibility="{Binding HasWorkspace, Converter={StaticResource BoolVisibility}}" CornerRadius="10" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="17"/>
                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,20" MinHeight="44"/>
                            <Button Content="Open studio" AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}" Command="{Binding OpenCommand}" Visibility="{Binding HasWorkspace, Converter={StaticResource BoolVisibility}}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,7"/>
                            <Button Content="{Binding ToggleText}" Command="{Binding ToggleServerCommand}" Visibility="{Binding HasWorkspace, Converter={StaticResource BoolVisibility}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Style="{StaticResource Card}" Margin="0,24,14,0" Background="{DynamicResource SubtleBrush}">
            <StackPanel>
                <TextBlock Text="Connect your first agent" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Start a studio server, copy its configuration to your MCP client, then open Live Inspector to watch the requests and results."
                           Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
