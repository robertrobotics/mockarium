<UserControl x:Class="Mockarium.Wpf.Views.StudioHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Restore starter" Command="{Binding RestoreCommand}" IsEnabled="{Binding IsConfigured}" Margin="0,0,8,0"/>
                <Button Content="{Binding ToggleText}" Command="{Binding ToggleServerCommand}" IsEnabled="{Binding HasWorkspace}"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                <Border Style="{StaticResource StudioStatusBadge}" CornerRadius="10" HorizontalAlignment="Left" Padding="9,3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </DockPanel>
        <Border Visibility="{Binding IsConfigured, Converter={StaticResource InverseBoolVisibility}}" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Create starter data" Command="{Binding CreateStarterCommand}" IsEnabled="{Binding HasWorkspace}"/>
                <StackPanel>
                    <TextBlock Text="STARTER DATA" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Start with sample data you can edit before connecting an agent." Margin="0,5,0,0" Foreground="{DynamicResource InkBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,14"
                Visibility="{Binding HasEndpoint, Converter={StaticResource BoolVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy endpoint" Command="{Binding CopyEndpointCommand}" Margin="0,0,8,0"/>
                    <Button Content="Copy configuration" Command="{Binding CopyConfigurationCommand}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="STREAMABLE HTTP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding Endpoint}" FontFamily="Consolas" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Expander Visibility="{Binding IsConfigured, Converter={StaticResource BoolVisibility}}" IsExpanded="{Binding ShowTools}" HorizontalContentAlignment="Stretch" Margin="0,0,0,20">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Agent toolkit" FontWeight="Bold"/>
                    <TextBlock Text="  ·  Browse available tools and schemas" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Expander.Header>
            <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Search the toolkit"/>
            <TextBox Text="{Binding ToolSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tool name, description, or input" AutomationProperties.Name="Search available tools"/>
            <TextBlock Text="No matching tools. Try a different name or input." Visibility="{Binding NoMatchingTools, Converter={StaticResource BoolVisibility}}" Margin="0,10" Foreground="{DynamicResource MutedBrush}"/>
            <ItemsControl ItemsSource="{Binding VisibleTools}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Name}" Margin="0,3" Background="{DynamicResource SurfaceBrush}" Padding="10">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding Schema, Mode=OneWay}" AutomationProperties.Name="Tool input schema" FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8"/>
                                <Button Content="Copy input schema" HorizontalAlignment="Left" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.CopyToolSchemaCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
