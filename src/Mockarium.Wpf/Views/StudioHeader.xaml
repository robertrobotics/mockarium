<UserControl x:Class="Mockarium.Wpf.Views.StudioHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource StudioIcon}" CornerRadius="16" Padding="20,16" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding IsConfigured, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton IsChecked="{Binding ShowTools}" Content="Connection and tools" Padding="10,6" Margin="0,0,6,0" ToolTip="Show endpoint, agent tools and starter data controls"/>
                        <Button Content="{Binding ToggleText}" Command="{Binding ToggleServerCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText, StringFormat='Server · {0}'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" VerticalAlignment="Center" Width="52" Height="52" CornerRadius="14" Margin="0,0,14,0" Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False">
                    <Path Style="{StaticResource StudioMark}" Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" StrokeThickness="2"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="MOCKARIUM   /   LOCAL SIMULATOR" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Visibility="{Binding IsConfigured, Converter={StaticResource InverseBoolVisibility}}" Style="{StaticResource Card}" Padding="24" Margin="0,2,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="STARTER KIT" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Starter.Title}" FontSize="24" FontWeight="SemiBold" Margin="0,8"/>
                    <TextBlock Text="{Binding Starter.Contents}" Foreground="{DynamicResource MutedBrush}"/>
                    <Button Content="Create starter data" Style="{StaticResource PrimaryButton}" Command="{Binding CreateStarterCommand}" IsEnabled="{Binding HasWorkspace}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TRY THIS FIRST" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding Starter.FirstTask}" Margin="0,7,0,0"/>
                        <TextBlock Text="You can edit offline. Start the server when you're ready to connect an agent." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}" Visibility="{Binding ShowTools, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10">
            <StackPanel Style="{StaticResource PanelEntrance}">
        <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,14"
                Visibility="{Binding HasEndpoint, Converter={StaticResource BoolVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy endpoint" Command="{Binding CopyEndpointCommand}" Margin="0,0,8,0"/>
                    <Button Content="Copy configuration" Command="{Binding CopyConfigurationCommand}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="STREAMABLE HTTP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding Endpoint}" FontFamily="Consolas" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
            <TextBlock Text="Start the server to get a client configuration. You can inspect tool inputs offline." Foreground="{DynamicResource MutedBrush}" Visibility="{Binding HasEndpoint, Converter={StaticResource InverseBoolVisibility}}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Search the toolkit"/>
            <TextBox Text="{Binding ToolSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tool name, description, or input" AutomationProperties.Name="Search available tools"/>
            <TextBlock Text="No matching tools. Try a different name or input." Visibility="{Binding NoMatchingTools, Converter={StaticResource BoolVisibility}}" Margin="0,10" Foreground="{DynamicResource MutedBrush}"/>
            <ItemsControl ItemsSource="{Binding VisibleTools}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Name}" Margin="0,3" Background="{DynamicResource SurfaceBrush}" Padding="10">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding Schema, Mode=OneWay}" AutomationProperties.Name="Tool input schema" FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8"/>
                                <Button Content="Copy input schema" HorizontalAlignment="Left" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.CopyToolSchemaCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Restore starter data" Command="{Binding RestoreCommand}"/>
                <TextBlock Text="Reset this studio to its original samples. Execution history is kept." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
