<UserControl x:Class="Mockarium.Wpf.Views.CalendarStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Mockarium.Wpf.Views">
    <StackPanel>
        <views:StudioHeader/>
        <TabControl IsEnabled="{Binding IsConfigured}" SelectedIndex="{Binding SelectedCalendarTabIndex}">
            <TabItem Header="Week">
                <Border Style="{StaticResource Card}" Margin="12" Padding="0">
                    <StackPanel>
                        <DockPanel Margin="18,16,18,8">
                            <Button DockPanel.Dock="Right" Content="+ New event" Command="{Binding NewEventFromWeekCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="12,7"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="‹" Command="{Binding PreviousWeekCommand}" ToolTip="Previous week"
                                        AutomationProperties.Name="Previous week" Padding="11,5" Margin="0,0,6,0"/>
                                <Button Content="This week" Command="{Binding ThisWeekCommand}" Padding="10,5" Margin="0,0,6,0"/>
                                <Button Content="›" Command="{Binding NextWeekCommand}" ToolTip="Next week"
                                        AutomationProperties.Name="Next week" Padding="11,5" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding WeekLabel}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Drag to move · Drag an event's lower edge to resize · Select an empty time to create"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="20,0,20,12"/>
                        <Grid Background="#F8F9FD" MinWidth="720">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding WeekTimeZone}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="5"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekDays}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" Margin="0,8">
                                            <TextBlock Text="{Binding Weekday}" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DayNumber}" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <ScrollViewer x:Name="WeekScroll" Height="520" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <views:WeekPlannerControl Blocks="{Binding WeekBlocks}" Height="1248" MinWidth="720"
                                                      AutomationProperties.Name="Weekly calendar. Use Agenda to edit events with the keyboard."/>
                        </ScrollViewer>
                        <TextBlock Text="Purple: scheduled   ·   Green: agent change   ·   Amber: scheduling conflict"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="18,12"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Agenda">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="New event" Command="{Binding NewEventCommand}" Padding="8,4"/>
                            <TextBlock Text="Events" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" AutomationProperties.Name="Calendar events" MinHeight="350" MaxHeight="570">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StartAt}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#4D826A" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Refresh calendar" Command="{Binding RefreshCommand}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Event details" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Date-times use ISO 8601 with an offset, for example 2025-03-10T13:00:00Z."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,4"/>
                        <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EventTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Event title"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Start" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EventStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Event start"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="End" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EventEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Event end"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Organizer email" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EventOrganizer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Organizer email"/>
                        <TextBlock Text="Attendees (one per line: email, response)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EventAttendees, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Attendees, one email and response per line" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                        <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EventLocation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Event location"/>
                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EventDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Event description" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding EventStatuses}" SelectedItem="{Binding EventStatus}" AutomationProperties.Name="Event status"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Save event" Command="{Binding SaveEventCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Delete" Command="{Binding DeleteEventCommand}" AutomationProperties.Name="Delete event" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Calendar setup">
                <Border Style="{StaticResource Card}" Margin="12" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Owner and simulated clock" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Agents use this clock and these working hours when finding availability." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,8"/>
                        <TextBlock Text="Owner name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner name"/>
                        <TextBlock Text="Owner email" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding OwnerEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner email"/>
                        <TextBlock Text="IANA time zone" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding OwnerTimeZone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner IANA time zone"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock Text="Work starts" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding WorkStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner work starts"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Work ends" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding WorkEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner work ends"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Simulated time (ISO 8601)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SimulatedTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Simulated time, ISO 8601"/>
                        <Button Content="Save calendar setup" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="People">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="New person" Command="{Binding NewPersonCommand}" Padding="8,4"/>
                            <TextBlock Text="People" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" AutomationProperties.Name="Calendar people" DisplayMemberPath="Name" MinHeight="260"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Person details" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PersonName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Person name"/>
                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PersonEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Person email"/>
                        <TextBlock Text="Company" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PersonCompany, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Person company"/>
                        <TextBlock Text="IANA time zone" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PersonTimeZone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Person IANA time zone"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock Text="Work starts" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PersonWorkStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Person work starts"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Work ends" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PersonWorkEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Person work ends"/></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Save person" Command="{Binding SavePersonCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Delete" Command="{Binding DeletePersonCommand}" AutomationProperties.Name="Delete person" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
